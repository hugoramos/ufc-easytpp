    "    # Parâmetros originais (moderados)\n",
    "    TRUE_MU = np.array([0.5])       # ← Apenas 1 valor: intensidade base\n",
    "    TRUE_ALPHA = np.array([[0.3]])  # ← Matriz 1x1: evento tipo 0 excita ele mesmo\n",
    "    TRUE_BETA = np.array([[1.0]])   # ← Matriz 1x1: taxa de decaimento\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"🎯 PARÂMETROS VERDADEIROS (GROUND TRUTH)\")\n",
    "print(\"=\"*70)\n",
    "print(\"\\nμ (Intensidade Base):\")\n",
    "print(TRUE_MU)\n",
    "print(\"\\nα (Excitação):\")\n",
