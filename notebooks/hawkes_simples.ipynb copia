    "            type_seqs_train[i:i+1],\n",
    "            batch_non_pad_mask_train[i:i+1],\n",
    "            None\n",
    "        )\n",
    "        loss, _ = model.loglike_loss(seq_batch)\n",
    "        losses_per_seq_train.append(loss.item())\n",
    "        print(f\"  Sequência TREINO {i+1}: Loss = {loss.item():.4f}\")\n",
    "\n",
    "print()\n",
    "\n",
    "# Calcular loss por sequência no conjunto de TESTE\n",
    "losses_per_seq_test = []\n",
    "for i in range(time_seqs_test.shape[0]):\n",
    "    seq_batch = (\n",
    "        time_seqs_test[i:i+1],\n",
    "        time_delta_seqs_test[i:i+1],\n",
    "        type_seqs_test[i:i+1],\n",
    "        batch_non_pad_mask_test[i:i+1],\n",
    "        None\n",
    "    )\n",
    "    loss, _ = model.loglike_loss(seq_batch)\n",
    "    losses_per_seq_test.append(loss.item())\n",
    "    print(f\"  Sequência TESTE {i+1}: Loss = {loss.item():.4f}\")\n",
    "\n",
    "print()\n",
    "print(f\"  Média TREINO: {sum(losses_per_seq_train)/len(losses_per_seq_train):.4f}\")\n",
