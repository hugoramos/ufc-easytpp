    "# ============================================================================\n",
    "# PARÂMETROS VERDADEIROS (GROUND TRUTH)\n",
    "# ============================================================================\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "# 🔬 TESTE CRÍTICO: Verificar se o gerador oficial produz clustering\n",
    "USE_STRONG_ALPHA = False  # ← TESTE: usar α=0.8 (muito alto)\n",
    "\n",
    "if USE_STRONG_ALPHA:\n",
    "    print(\"=\"*70)\n",
    "    print(\"⚠️  MODO DE TESTE: Usando α=0.8 (MUITO ALTO) para verificar clustering\")\n",
    "    print(\"   Se a correlação ainda for ~0, o gerador OFICIAL tem um BUG!\")\n",
    "    print(\"=\"*70 + \"\\n\")\n",
    "    TRUE_MU = np.array([0.5])       # ← Intensidade base\n",
    "    TRUE_ALPHA = np.array([[0.8]])  # ← MUITO ALTO (80% excitação!)\n",
    "    TRUE_BETA = np.array([[2.0]])   # ← Alto para manter estabilidade (α/β=0.4 < 1)\n",
