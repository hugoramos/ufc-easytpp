    "print(\"\\nβ (Decaimento):\")\n",
    "print(TRUE_BETA)\n",
    "print(f\"\\n⚖️  Razão α/β: {TRUE_ALPHA[0,0]/TRUE_BETA[0,0]:.4f} ({'✅ Estável' if TRUE_ALPHA[0,0] < TRUE_BETA[0,0] else '❌ Instável'})\")\n",
    "print(\"\\n💡 O modelo vai tentar aprender estes parâmetros a partir dos dados!\")\n",
    "\n",
    "# ============================================================================\n",
    "# GERADOR HAWKES OFICIAL DO EASYTPP\n",
    "# ============================================================================\n",
    "# Usando: easy_tpp/utils/gen_utils.py\n",
    "\n",
    "from easy_tpp.utils.gen_utils import generate_synthetic_data\n",
    "\n",
    "def generate_synthetic_hawkes_data(mu, alpha, beta, num_sequences, T_max=20.0, seed=42):\n",
    "    \"\"\"\n",
    "    Gera dados sintéticos usando o gerador OFICIAL do EasyTPP\n",
    "    \n",
    "    Args:\n",
    "        mu: array [1] - intensidade base\n",
    "        alpha: array [[α]] - matriz de excitação 1x1\n",
    "        beta: array [[β]] - matriz de decaimento 1x1\n",
    "        num_sequences: int - número de sequências a gerar\n",
    "        T_max: float - tempo máximo de cada sequência\n",
    "        seed: int - seed para reprodutibilidade\n",
    "    \n",
    "    Returns:\n",
    "        tuple: (time_seqs, time_delta_seqs, type_seqs) como tensores PyTorch\n",
    "    \"\"\"\n",
    "    np.random.seed(seed)\n",
    "    \n",
    "    # Extrair valores escalares (para 1 tipo)\n",
    "    mu_val = mu[0]\n",
    "    alpha_val = alpha[0, 0]\n",
    "    beta_val = beta[0, 0]\n",
    "    \n",
    "    print(f\"\\n🔬 Usando gerador OFICIAL do EasyTPP:\")\n",
    "    print(f\"   generate_synthetic_data() de easy_tpp/utils/gen_utils.py\")\n",
    "    print(f\"   μ={mu_val:.2f}, α={alpha_val:.2f}, β={beta_val:.2f}, T_MAX={T_max}\")\n",
    "    \n",
    "    all_times = []\n",
    "    all_types = []\n",
    "    max_len = 0\n",
    "    \n",
    "    for seq_idx in range(num_sequences):\n",
    "        # Chamar gerador oficial do EasyTPP\n",
    "        # Ele retorna: list de lists de dicts com 'time_since_start', 'type_event'\n",
    "        events_by_node = generate_synthetic_data(\n",
    "            n_nodes=1,              # 1 tipo de evento\n",
    "            end_time=T_max,         # tempo máximo\n",
    "            baseline=mu_val,        # μ (intensidade base)\n",
    "            adjacency=alpha_val,    # α (excitação)\n",
    "            decay=beta_val          # β (decaimento)\n",
    "        )\n",
    "        \n",
    "        # Extrair tempos do nó 0 (único tipo)\n",
    "        node_events = events_by_node[0]\n",
    "        times = [e['time_since_start'] for e in node_events]\n",
    "        \n",
    "        # Adicionar tempo 0 no início se não existir\n",
    "        if len(times) == 0:\n",
    "            times = [0.0]\n",
    "        elif times[0] != 0.0:\n",
    "            times = [0.0] + times\n",
    "        \n",
    "        types = [0] * len(times)  # Apenas tipo 0\n",
    "        \n",
    "        max_len = max(max_len, len(times))\n",
    "        all_times.append(times)\n",
    "        all_types.append(types)\n",
    "    \n",
    "    # Estatísticas\n",
    "    num_events = [len(t) for t in all_times]\n",
    "    print(f\"✅ Gerado! {num_sequences} sequências, média {np.mean(num_events):.1f} eventos/seq\")\n",
    "    \n",
    "    # Padding e criação de tensores\n",
    "    time_seqs_list = []\n",
    "    time_delta_seqs_list = []\n",
    "    type_seqs_list = []\n",
    "    \n",
    "    for times, types in zip(all_times, all_types):\n",
    "        # Calcular deltas\n",
    "        deltas = [times[i] - times[i-1] if i > 0 else 0.0 for i in range(len(times))]\n",
    "        \n",
    "        # Padding\n",
    "        while len(times) < max_len:\n",
    "            times.append(times[-1])\n",
    "            deltas.append(0.0)\n",
    "            types.append(0)\n",
    "        \n",
    "        time_seqs_list.append(times[:max_len])\n",
    "        time_delta_seqs_list.append(deltas[:max_len])\n",
    "        type_seqs_list.append(types[:max_len])\n",
    "    \n",
    "    return (torch.tensor(time_seqs_list, dtype=torch.float32),\n",
    "            torch.tensor(time_delta_seqs_list, dtype=torch.float32),\n",
    "            torch.tensor(type_seqs_list, dtype=torch.long))\n",
    "\n",
    "# ============================================================================\n",
    "# GERAR DADOS COM PARÂMETROS CONHECIDOS\n",
    "# ============================================================================\n",
    "\n",
    "# Usar parâmetros do painel de controle\n",
    "NUM_TRAIN_SEQS = cfg['num_train']\n",
    "NUM_TEST_SEQS = cfg['num_test']\n",
    "T_MAX = cfg['T_max']\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"GERANDO DADOS SINTÉTICOS COM PARÂMETROS CONHECIDOS\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "time_seqs_train, time_delta_seqs_train, type_seqs_train = generate_synthetic_hawkes_data(\n",
    "    TRUE_MU, TRUE_ALPHA, TRUE_BETA, NUM_TRAIN_SEQS, T_MAX, seed=42\n",
    ")\n",
    "\n",
    "time_seqs_test, time_delta_seqs_test, type_seqs_test = generate_synthetic_hawkes_data(\n",
    "    TRUE_MU, TRUE_ALPHA, TRUE_BETA, NUM_TEST_SEQS, T_MAX, seed=999\n",
    ")\n",
    "\n",
    "batch_non_pad_mask_train = torch.ones_like(time_seqs_train)\n",
    "batch_non_pad_mask_test = torch.ones_like(time_seqs_test)\n",
    "\n",
    "batch_train = (time_seqs_train, time_delta_seqs_train, type_seqs_train, batch_non_pad_mask_train, None)\n",
    "batch_test = (time_seqs_test, time_delta_seqs_test, type_seqs_test, batch_non_pad_mask_test, None)\n",
    "\n",
    "# Calcular número de parâmetros\n",
    "num_types = 1\n",
    "num_params = num_types + (num_types * num_types) + (num_types * num_types)  # μ + α + β\n",
    "# Para 1 tipo: 1 + 1 + 1 = 3 parâmetros\n",
    "\n",
    "print(f\"\\n✅ TREINO: {NUM_TRAIN_SEQS} sequências, {time_seqs_train.shape[1]} eventos/seq\")\n",
    "print(f\"✅ TESTE:  {NUM_TEST_SEQS} sequências, {time_seqs_test.shape[1]} eventos/seq\")\n",
    "print(f\"\\n📊 Total de eventos: {NUM_TRAIN_SEQS * time_seqs_train.shape[1]} (treino)\")\n",
    "print(f\"📊 Parâmetros: {num_params} (1 μ + 1 α + 1 β)\")\n",
    "print(f\"📊 Razão dados/parâmetros: {(NUM_TRAIN_SEQS * time_seqs_train.shape[1]) / num_params:.1f}x\")\n",
    "print(f\"\\n💡 Com apenas 3 parâmetros, o modelo é muito mais simples de treinar!\")\n"
