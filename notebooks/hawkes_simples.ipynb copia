    "\n",
    "# Calcular loss por sequência no conjunto de TREINO\n",
    "with torch.no_grad():\n",
    "    losses_per_seq_train = []\n",
    "    for i in range(time_seqs_train.shape[0]):\n",
    "        seq_batch = (\n",
    "            time_seqs_train[i:i+1],\n",
